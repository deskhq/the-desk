#!/usr/bin/env bash
#
# bin/browser-tests — run the browser (E2E) suite under paratest with an
# explicitly capped worker count (see issue #948).
#
# tests/Browser ran strictly single-process for a long time, on the premise that
# binding Reverb and a live server made it unshardable (#647). It does not:
# pest-plugin-browser reconnects every paratest worker to one shared Playwright
# server (persisted to .temp/playwright-server.json) and gives each worker its
# own in-process HTTP server on its own free port, so there is nothing to
# contend over. Reverb is a single long-running service every worker publishes
# to, and each channel name is scoped by a model UUID drawn from that worker's
# own testing_N database, so two workers cannot collide on a channel either.
# Measured at 4.4x on a 12-core machine (535s serial -> 122s at 6 workers).
#
# The worker count is the part that has to be deliberate. `--parallel` with no
# `--processes` defaults to the core count, and running as many workers as cores
# is the *worst* setting: browsers, PHP servers and Playwright then compete for
# the same cores, and the suite comes out both slower and much flakier than at
# half that — the failures being exactly the CPU-starvation class of #786, where
# viewport/geometry assertions read layout before it settles. So: half the
# cores, never below two.
#
# Which is also why this runner reaps. Every run used to leave its Playwright
# server running (#955): `Pest\Plugins\Parallel::handleArguments()` ends the
# parallel parent with `exit()` as soon as paratest returns, so the browser
# plugin's `terminate()` — the only caller of `playwright()->stop()` — never runs
# in the very process that started the server. A killed run adds its paratest
# workers to the pile. Those leftovers then eat the cores the paragraph above is
# about, and a machine that has run a few sweeps starts failing unrelated tests
# as though the application had regressed.
#
# Usage:
#   bin/browser-tests [extra pest arguments]     # e.g. --ci
#
# Config (environment overrides):
#   BROWSER_TEST_PROCESSES   Pin the worker count instead of deriving it from
#                            the cores visible here (useful to measure another
#                            setting, or on a host whose reported core count
#                            does not reflect the cycles it can actually give).
#   BROWSER_TEST_BAIL        0 to run the whole suite instead of stopping at the
#                            first defect, for the runs that want every failure
#                            at once: a broad refactor, a flaky sweep, a triage
#                            run. Defaults to 1.

set -euo pipefail

# This checkout, resolved at source time so the helpers below hold no matter
# which directory they are called from.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Command-line fragments that identify a process this suite owns. The Playwright
# server is the one every run leaks; the workers leak whenever a run is killed,
# and the obvious `pkill -f "pest tests/Browser"` misses them entirely because a
# paratest worker runs as `pest/bin/worker.php --test-directory=tests`, naming
# neither pest's invocation nor the browser suite.
SUITE_COMMANDS=(
    'playwright run-server'
    'pest/bin/worker.php'
)

# How long a stray is given to take its own children down before it is killed
# outright: the Playwright server closes the browsers it launched when it is
# asked to stop, and a SIGKILL would orphan those in turn.
REAP_GRACE_SECONDS=2

# Refuse to run against a bundle older than the sources it was built from: the
# suite serves public/build, so a stale bundle fails every test as though the
# app were broken, aimed squarely at whatever landed most recently (#949).
#
# tests/Pest.php runs the same guard in-process, which is what covers the
# documented `pest tests/Browser` entry point. Repeating it here is about the
# output: a guard that aborts a paratest worker reads as a
# WorkerCrashedException followed by paratest's own usage dump, while failing
# before the fork prints the one message and nothing else.
assert_fresh_bundle() {
    php -r 'require $argv[1]; Tests\Support\StaleBundleGuard::ensureFreshBundle($argv[2]);' \
        "$REPO_ROOT/tests/Support/StaleBundleGuard.php" "${1:-$REPO_ROOT}"
}

# Refuse to run without a Reverb server: the realtime tests subscribe real Echo
# clients to one, so a stopped container fails them test by test on the message
# each was waiting for, which reads as a broadcasting regression rather than as
# the missing WebSocket server it is (#954). Running the PHP gate is enough to
# leave the container stopped, and nothing else reports that.
#
# Checked here as well as in tests/Pest.php for the same reason as the bundle
# above: this is the entry point `composer test:browser` and CI come through,
# and failing before the fork prints one message instead of a worker crash.
assert_reverb_is_running() {
    php -r 'require $argv[1]; Tests\Support\ReverbGuard::ensureReverbIsRunning($argv[2]);' \
        "$REPO_ROOT/tests/Support/ReverbGuard.php" "${1:-$REPO_ROOT}"
}

# Whether the given pid runs out of this checkout, so that a run here never
# reaps the server a sibling worktree on the same machine is using.
#
# Read from /proc, which exists in the Sail container the suite runs in and on
# CI. Where it does not — a macOS host — the process is claimed rather than
# spared: sparing would disable the reaper entirely on the one platform that
# cannot prove ownership, and `playwright run-server` under this repo's own
# process table is specific enough to act on.
runs_from_this_checkout() {
    [ -d /proc ] || return 0

    [ "$(readlink "/proc/$1/cwd" 2>/dev/null)" = "$REPO_ROOT" ]
}

# The suite's processes that no longer have an owner, one `<pid> <command>` line
# each. Being orphaned onto init is what tells a leftover apart from a live one:
# a run still in progress keeps its parent, so a second suite running alongside
# this one — or the PHP gate, whose paratest workers are indistinguishable from
# this suite's — is never touched.
stray_processes() {
    local pid parent command fragment

    while read -r pid parent command; do
        [ "$parent" = '1' ] || continue

        for fragment in "${SUITE_COMMANDS[@]}"; do
            case "$command" in
                *"$fragment"*)
                    if runs_from_this_checkout "$pid"; then
                        printf '%s %s\n' "$pid" "$command"
                    fi

                    break
                    ;;
            esac
        done
    done < <(ps -eo pid=,ppid=,args=)
}

# Kills the strays, naming each one so a degraded machine says so itself instead
# of producing a mystery red sweep several minutes later.
#
# Swept repeatedly because the leftovers nest: the Playwright server runs behind
# the shell that launched it, so reaping that orphaned shell is what reparents
# the node process onto init — one pass too late for the sweep that caused it.
reap_strays() {
    local when=$1 pass

    for pass in 1 2 3; do
        reap_one_generation "$when" || return 0
    done
}

# Kills the strays visible right now, reporting them. Returns non-zero when
# there were none, which is what ends the sweep above.
reap_one_generation() {
    local when=$1 line pids=() reaped=()

    while IFS= read -r line; do
        pids+=("${line%% *}")
        reaped+=("$line")
    done < <(stray_processes)

    if [ ${#pids[@]} -eq 0 ]; then
        return 1
    fi

    printf '==> reaping %d stray browser-suite process(es) %s:\n' "${#pids[@]}" "$when" >&2
    printf '      %s\n' "${reaped[@]}" >&2

    kill -TERM "${pids[@]}" 2>/dev/null || true
    sleep "$REAP_GRACE_SECONDS"

    survivors_of "${pids[@]}"
}

# SIGKILLs whichever of the given pids are still strays, which is not the same
# as SIGKILLing whatever is left holding those pids: one of them can have exited
# and had its number handed to something entirely unrelated during the grace
# period above. Anything orphaned *since* the sweep started is left to the next
# one, so that it too gets asked to stop before it is killed.
survivors_of() {
    local target line pid survivors=()

    while IFS= read -r line; do
        pid=${line%% *}

        for target in "$@"; do
            if [ "$pid" = "$target" ]; then
                survivors+=("$pid")

                break
            fi
        done
    done < <(stray_processes)

    if [ ${#survivors[@]} -gt 0 ]; then
        kill -KILL "${survivors[@]}" 2>/dev/null || true
    fi
}

# Stops the run this shell is waiting on, then the shell itself with the given
# status. Signals reap through the EXIT trap rather than directly, so that an
# interrupted run and a completed one leave by the same path.
stop_run() {
    if [ -n "${RUN_PID:-}" ]; then
        kill -TERM "$RUN_PID" 2>/dev/null || true
        wait "$RUN_PID" 2>/dev/null || true
    fi

    exit "$1"
}

# Runs the given command with the reaping around it: strays from earlier runs
# before it starts, whatever this run leaves once it ends, however it ends.
#
# The command is run as a child rather than exec'd, which is the whole point —
# an exec'd pest replaces this shell, and a replaced shell has no trap left to
# fire. It is waited on rather than run in the foreground for the same kind of
# reason: bash defers a trap until the foreground command returns, so a signal
# aimed at the runner alone would otherwise be answered only once the suite had
# run to completion on its own.
run_reaped() {
    reap_strays 'left behind by an earlier run'

    trap 'reap_strays "left behind by this run"' EXIT
    trap 'stop_run 130' INT
    trap 'stop_run 143' TERM

    "$@" &
    RUN_PID=$!

    wait "$RUN_PID"
}

# The number of CPUs visible to this machine or container. Falls back to 0 —
# which worker_count floors — rather than guessing on an exotic host.
detect_cores() {
    if command -v nproc >/dev/null 2>&1; then
        nproc
    elif command -v sysctl >/dev/null 2>&1; then
        sysctl -n hw.ncpu
    else
        echo 0
    fi
}

# Half of $1 cores, floored at two workers.
worker_count() {
    local workers=$(( ${1:-0} / 2 ))

    if [ "$workers" -lt 2 ]; then
        workers=2
    fi

    printf '%s\n' "$workers"
}

resolve_processes() {
    local override=${BROWSER_TEST_PROCESSES:-}

    if [ -z "$override" ]; then
        worker_count "$(detect_cores)"
        return
    fi

    # A bad override would otherwise reach paratest as `--processes=nonsense`
    # and die several seconds into a run with an error naming pest, not the
    # variable that caused it.
    if ! [ "$override" -ge 1 ] 2>/dev/null; then
        printf 'BROWSER_TEST_PROCESSES must be a positive integer, got "%s"\n' "$override" >&2
        exit 1
    fi

    printf '%s\n' "$override"
}

# The fail-fast flag, or nothing when BROWSER_TEST_BAIL turns it off.
#
# `--stop-on-defect` rather than pest's own `--bail`, which is only sugar for it
# (`Pest\Plugins\Bail` rewrites `--bail` into `--stop-on-failure
# --stop-on-error` before `Plugins\Parallel` hands the arguments to paratest).
# Both work here, but only `--stop-on-defect` also survives `php artisan test
# --parallel` — Collision validates the options it forwards against paratest's
# own input definition before it ever spawns pest, and dies on `The "--bail"
# option does not exist`. The PHP gate therefore has to spell it this way, and
# one spelling across both suites beats pest's nicer one on the suite that
# happens to accept it.
resolve_bail() {
    local override=${BROWSER_TEST_BAIL:-1}

    case "$override" in
        1) printf '%s\n' '--stop-on-defect' ;;
        0) ;;
        *)
            printf 'BROWSER_TEST_BAIL must be 0 or 1, got "%s"\n' "$override" >&2
            exit 1
            ;;
    esac
}

# Fills the PEST_COMMAND array with the invocation to run, so main and the
# tests that pin it read the same command rather than two copies of it.
build_pest_command() {
    local bail
    bail=$(resolve_bail)

    PEST_COMMAND=(vendor/bin/pest tests/Browser --parallel "--processes=$(resolve_processes)")

    [ -z "$bail" ] || PEST_COMMAND+=("$bail")

    PEST_COMMAND+=("$@")
}

# The invocation in printable form, one argument per line.
pest_command() {
    build_pest_command "$@"

    printf '%s\n' "${PEST_COMMAND[@]}"
}

main() {
    cd "$REPO_ROOT"

    assert_fresh_bundle
    assert_reverb_is_running

    build_pest_command "$@"
    printf '==> %s\n' "${PEST_COMMAND[*]}" >&2

    run_reaped "${PEST_COMMAND[@]}"
}

# Sourcing with BROWSER_TESTS_LIB=1 defines the helpers without running the
# suite, so tests/Unit/BrowserSuiteParallelTest.php can drive them directly.
[ -n "${BROWSER_TESTS_LIB:-}" ] || main "$@"
